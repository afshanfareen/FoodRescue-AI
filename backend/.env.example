# Database — use psycopg (v3) driver prefix
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/foodrescue

# JWT
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# AI Model paths
AI_MODEL_DIR=ai_models

# Optional: OSRM routing (leave empty to use Haversine fallback)
OSRM_URL=
